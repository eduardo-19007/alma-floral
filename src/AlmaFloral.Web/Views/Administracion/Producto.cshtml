@model AlmaFloral.Web.ViewModels.ProductoEditarViewModel
@{ViewData["Title"]=Model.Id==0?"Nuevo producto":"Editar producto";}<section class="order-heading"><p class="eyebrow">CATÁLOGO E INVENTARIO</p><h1>@ViewData["Title"]</h1></section><nav class="admin-nav" aria-label="Administración"><a asp-action="Index">Resumen</a><a asp-action="Productos">Productos</a><a asp-action="Pedidos">Pedidos</a><a asp-action="Casos">Postventa</a></nav><partial name="_Mensajes" />
<form asp-action="Producto" method="post" class="order-panel order-form lookup-form"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden" /><div class="order-fields"><div class="field-wide"><label asp-for="Nombre"></label><input asp-for="Nombre" class="form-control" /></div><div class="field-wide"><label asp-for="Descripcion"></label><textarea asp-for="Descripcion" class="form-control" rows="3"></textarea></div><div><label asp-for="Precio"></label><input asp-for="Precio" class="form-control" type="number" step="0.01" min="0.01" max="100000" /></div><div><label asp-for="StockFisico"></label><input asp-for="StockFisico" class="form-control" min="@Model.StockReservado" /><small>@Model.StockReservado unidades reservadas</small></div><div class="field-wide"><label><input asp-for="Activo" /> Visible en el catálogo</label></div></div><button class="floral-button" type="submit">Guardar producto</button></form>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
