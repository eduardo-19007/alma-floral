@model List<AlmaFloral.Web.Models.CasoPostventa>
@{ViewData["Title"]="Gestión de postventa";}<section class="order-heading"><p class="eyebrow">ESCUCHAMOS CADA EXPERIENCIA</p><h1>Atención de postventa.</h1><p>Últimos 200 casos. Cada solicitud permanece vinculada a su pedido.</p></section><nav class="admin-nav" aria-label="Administración"><a asp-action="Index">Resumen</a><a asp-action="Productos">Productos</a><a asp-action="Pedidos">Pedidos</a><a asp-action="Casos">Postventa</a></nav><partial name="_Mensajes" />
<div class="order-panel table-responsive"><table class="table"><thead><tr><th>Caso</th><th>Pedido</th><th>Tipo</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var c in Model){<tr><td>#@c.CasoPostventaId</td><td class="code-cell">@c.Pedido.Codigo</td><td>@c.Tipo</td><td>@c.Estado</td><td><a asp-action="Caso" asp-route-id="@c.CasoPostventaId">Atender</a></td></tr>}</tbody></table>@if(Model.Count==0){<p>No hay casos registrados.</p>}</div>
