@model AlmaFloral.Web.ViewModels.AtenderCasoViewModel
@{ViewData["Title"]="Atender caso";var caso=(AlmaFloral.Web.Models.CasoPostventa)ViewData["Caso"]!;}<section class="order-heading"><p class="eyebrow">SEGUIMIENTO Y RESOLUCIÓN</p><h1>Caso #@caso.CasoPostventaId</h1></section><nav class="admin-nav" aria-label="Administración"><a asp-action="Index">Resumen</a><a asp-action="Productos">Productos</a><a asp-action="Pedidos">Pedidos</a><a asp-action="Casos">Postventa</a></nav><partial name="_Mensajes" />
<section class="order-panel"><p class="order-code">@caso.Pedido.Codigo</p><dl class="order-facts"><div><dt>Tipo</dt><dd>@caso.Tipo</dd></div><div><dt>Estado</dt><dd>@caso.Estado</dd></div><div><dt>Responsable</dt><dd>@(caso.Usuario?.Nombre??"Sin asignar")</dd></div></dl><h2>Solicitud del cliente</h2><p class="preserve-lines">@caso.Descripcion</p></section>
@if(caso.Estado!="Cerrado") {<form asp-action="Caso" method="post" class="order-panel order-form admin-table"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden" /><div class="order-fields"><div class="field-wide"><label asp-for="Estado"></label><select asp-for="Estado" class="form-select"><option value="En atención">En atención</option>@if(caso.Estado=="En atención"){<option value="Cerrado">Cerrado</option>}</select></div><div class="field-wide"><label asp-for="Respuesta"></label><textarea asp-for="Respuesta" class="form-control" rows="3"></textarea></div><div class="field-wide"><label asp-for="Acuerdo">Acuerdo o resolución</label><textarea asp-for="Acuerdo" class="form-control" rows="3"></textarea><small>La respuesta y el acuerdo son obligatorios para cerrar. La resolución no ejecuta reembolsos ni cambia el inventario.</small></div></div><button type="submit" class="floral-button">Guardar atención</button></form>}
else {<section class="order-panel admin-table"><h2>Respuesta y acuerdo registrados</h2><p class="preserve-lines">@caso.Respuesta</p><p class="preserve-lines">@caso.Acuerdo</p><p>Cierre registrado: @caso.FechaCierre?.ToString("dd/MM/yyyy HH:mm") UTC</p></section>}
@section Scripts {<partial name="_ValidationScriptsPartial" />}
