@model AlmaFloral.Web.Models.Pedido
@{ViewData["Title"]="Atender pedido";}<section class="order-heading"><p class="eyebrow">ATENCIÓN DE PEDIDOS</p><h1>Un detalle en camino.</h1></section><nav class="admin-nav" aria-label="Administración"><a asp-action="Index">Resumen</a><a asp-action="Productos">Productos</a><a asp-action="Pedidos">Pedidos</a><a asp-action="Casos">Postventa</a></nav><partial name="_Mensajes" />
<partial name="~/Views/Pedidos/_Resumen.cshtml" model="Model" />
<section class="order-panel admin-table"><h2>Coordinación de la entrega</h2><dl class="order-facts"><div><dt>Cliente</dt><dd>@Model.Cliente.Nombre</dd></div><div><dt>Teléfono</dt><dd>@Model.Cliente.Telefono</dd></div><div><dt>Correo</dt><dd>@(Model.Cliente.Correo??"No indicado")</dd></div></dl>@if(Model.ModalidadEntrega=="Delivery"){<p><strong>Dirección:</strong> @Model.DireccionEntrega</p>}<p>La preparación conserva la reserva. La entrega descuenta el stock físico y libera la reserva. La cancelación solo está disponible antes de preparar.</p>
<div class="order-actions">@foreach(var destino in Model.Estado switch {"Pendiente"=>new[]{"En preparación","Cancelado"},"En preparación"=>new[]{"Listo"},"Listo"=>new[]{"Entregado"},_=>Array.Empty<string>()}){<form method="post" asp-action="EstadoPedido"><input name="id" value="@Model.PedidoId" type="hidden" /><input name="estado" value="@destino" type="hidden" /><button class="floral-button" type="submit">@destino</button></form>}</div></section>
