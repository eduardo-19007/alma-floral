@model List<AlmaFloral.Web.Models.Pedido>
@{ViewData["Title"]="Gestión de pedidos";}<section class="order-heading"><p class="eyebrow">DEL DETALLE A LA ENTREGA</p><h1>Pedidos por acompañar.</h1><p>Últimos 200 pedidos registrados. Abre un pedido para coordinar su atención.</p></section><nav class="admin-nav" aria-label="Administración"><a asp-action="Index">Resumen</a><a asp-action="Productos">Productos</a><a asp-action="Pedidos">Pedidos</a><a asp-action="Casos">Postventa</a></nav><partial name="_Mensajes" />
<div class="order-panel table-responsive"><table class="table"><thead><tr><th>Código</th><th>Estado</th><th>Modalidad</th><th>Acción</th></tr></thead><tbody>@foreach(var p in Model){<tr><td class="code-cell">@p.Codigo</td><td>@p.Estado</td><td>@p.ModalidadEntrega</td><td><a asp-action="Pedido" asp-route-id="@p.PedidoId">Atender</a></td></tr>}</tbody></table>@if(Model.Count==0){<p>No hay pedidos registrados.</p>}</div>
