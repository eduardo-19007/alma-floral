@model List<AlmaFloral.Web.Models.Producto>
@{ViewData["Title"]="Gestión de productos";}<section class="order-heading"><p class="eyebrow">CATÁLOGO E INVENTARIO</p><h1>Productos con historia.</h1><p>Actualiza el catálogo y las existencias. Desactiva los productos sin eliminar sus pedidos.</p></section><nav class="admin-nav" aria-label="Administración"><a asp-action="Index">Resumen</a><a asp-action="Productos">Productos</a><a asp-action="Pedidos">Pedidos</a><a asp-action="Casos">Postventa</a></nav><partial name="_Mensajes" />
<a class="floral-button" asp-action="Producto">Nuevo producto</a><div class="order-panel admin-table table-responsive"><table class="table"><thead><tr><th>Producto</th><th>Precio S/</th><th>Físico</th><th>Reservado</th><th>Disponible</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Nombre</td><td>@p.Precio.ToString("0.00",System.Globalization.CultureInfo.InvariantCulture)</td><td>@p.StockFisico</td><td>@p.StockReservado</td><td>@p.Stock</td><td>@(p.Activo?"Activo":"Inactivo")</td><td><a asp-action="Producto" asp-route-id="@p.Id">Editar</a></td></tr>}</tbody></table></div>
