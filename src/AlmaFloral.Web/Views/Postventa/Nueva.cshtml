@model AlmaFloral.Web.ViewModels.PostventaViewModel
@{ViewData["Title"]="Atención de postventa";}<section class="order-heading"><p class="eyebrow">SEGUIMOS A TU LADO</p><h1>Cuéntanos cómo podemos ayudarte.</h1><p>Registra una consulta, reclamo o solicitud vinculada a tu pedido. Podrás seguir la atención desde Mi pedido.</p></section>
<form method="post" asp-action="Nueva" class="order-panel order-form lookup-form"><div asp-validation-summary="All" class="text-danger" role="alert"></div><div class="order-fields"><div class="field-wide"><label asp-for="Codigo"></label><input asp-for="Codigo" class="form-control" autocomplete="off" /></div><div class="field-wide"><label asp-for="Telefono"></label><input asp-for="Telefono" class="form-control" type="tel" /></div><div class="field-wide"><label asp-for="Tipo"></label><select asp-for="Tipo" class="form-select"><option>Consulta</option><option>Reclamo</option><option>Solicitud</option></select></div><div class="field-wide"><label asp-for="Descripcion"></label><textarea asp-for="Descripcion" class="form-control" rows="5"></textarea></div></div><button type="submit" class="floral-button">Registrar solicitud</button></form>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
