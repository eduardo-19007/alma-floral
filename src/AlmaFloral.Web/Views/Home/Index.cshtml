@{
    ViewData["Title"] = "Inicio";
}

<section class="rounded-3 p-4 p-md-5 mb-4"
         style="background-color: #f3f6ef;">
    <p class="text-uppercase fw-semibold text-success mb-2">
        Florería Alma Floral
    </p>

    <h1 class="display-5 fw-bold" style="color: #214e35;">
        Flores para acompañar tus momentos especiales
    </h1>

    <p class="lead mt-3 mb-0">
        Arreglos florales personalizados, plantas decorativas
        y regalos para compartir.
    </p>
</section>

<section aria-labelledby="servicios-titulo">
    <h2 id="servicios-titulo" class="mb-4">
        Conoce nuestra propuesta
    </h2>

    <div class="row g-4">
        <div class="col-md-4">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="h5 text-success">Arreglos florales</h3>
                    <p class="mb-0">
                        Composiciones florales para cumpleaños,
                        aniversarios y otras ocasiones especiales.
                    </p>
                </div>
            </article>
        </div>

        <div class="col-md-4">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="h5 text-success">Plantas decorativas</h3>
                    <p class="mb-0">
                        Opciones naturales para dar vida
                        a tus espacios y compartir como regalo.
                    </p>
                </div>
            </article>
        </div>

        <div class="col-md-4">
            <article class="card h-100 border-0 shadow-sm">
                <div class="card-body p-4">
                    <h3 class="h5 text-success">Atención personalizada</h3>
                    <p class="mb-0">
                        Orientación para elegir los productos
                        que acompañen cada ocasión.
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>